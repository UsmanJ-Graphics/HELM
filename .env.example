DATABASE_URL=postgresql://helm:helm@postgres:5432/helm
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# For Groq instead: https://api.groq.com/openai/v1 and model openai/gpt-oss-20b
SIMULATION_TICK_MS=1000
PORT=3001
CLIENT_URL=http://localhost:5173

# Optional local role access control; Captain map is SHIP_ID=code pairs separated by commas.
COMMAND_ACCESS_CODE=
CAPTAIN_ACCESS_CODES=
